# cmake/deps/scripting.cmake - Lua 5.4 (built from upstream sources) + sol2
# OWNER: the scripting module agent may edit this file to fix integration of its own
# dependencies. Included by cmake/Dependencies.cmake only when the module is enabled.

FetchContent_Declare(lua
    GIT_REPOSITORY https://github.com/lua/lua.git
    GIT_TAG        v5.4.7
    GIT_SHALLOW    TRUE
    SOURCE_SUBDIR  _none_
    SYSTEM)
FetchContent_Declare(sol2
    GIT_REPOSITORY https://github.com/ThePhD/sol2.git
    GIT_TAG        v3.5.0
    GIT_SHALLOW    TRUE
    SOURCE_SUBDIR  _none_
    SYSTEM)
FetchContent_MakeAvailable(lua sol2)

set(_ae_lua_srcs
    lapi lcode lctype ldebug ldo ldump lfunc lgc llex lmem lobject lopcodes lparser
    lstate lstring ltable ltm lundump lvm lzio
    lauxlib lbaselib lcorolib ldblib liolib lmathlib loadlib loslib lstrlib ltablib
    lutf8lib linit)
list(TRANSFORM _ae_lua_srcs PREPEND "${lua_SOURCE_DIR}/")
list(TRANSFORM _ae_lua_srcs APPEND ".c")
add_library(aether_lua STATIC ${_ae_lua_srcs})
set_target_properties(aether_lua PROPERTIES LINKER_LANGUAGE C FOLDER "third_party")
# The lua/lua dev repo ships no lua.hpp; generate the canonical C++ wrapper.
set(_ae_lua_gen "${CMAKE_BINARY_DIR}/generated/lua")
file(WRITE "${_ae_lua_gen}/lua.hpp"
    "// Generated by Aether (Dependencies.cmake)\nextern \"C\" {\n#include \"lua.h\"\n#include \"lualib.h\"\n#include \"lauxlib.h\"\n}\n")
target_include_directories(aether_lua SYSTEM PUBLIC "${lua_SOURCE_DIR}" "${_ae_lua_gen}")

add_library(aether_sol2 INTERFACE)
target_include_directories(aether_sol2 SYSTEM INTERFACE "${sol2_SOURCE_DIR}/include")
target_link_libraries(aether_sol2 INTERFACE aether_lua)
target_compile_definitions(aether_sol2 INTERFACE SOL_ALL_SAFETIES_ON=1)
