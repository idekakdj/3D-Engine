// shaders/renderer/bloom_down.comp — 13-tap downsample (Jimenez, CoD:AW) into the next,
// half-sized bloom level. The first level uses a Karis average to suppress fireflies.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "color.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant, scalar) uniform BloomPush {
    uint  src_tex;
    uint  add_tex;
    uint  dst_img;
    uint  flags;
    vec2  src_texel;
    uvec2 dst_size;
    float radius;
    uint  pad0;
    uint  pad1;
    uint  pad2;
} pc;

vec3 tap(vec2 uv, vec2 offset) {
    vec3 c = textureLod(AE_TEX2D(pc.src_tex), uv + offset * pc.src_texel, 0.0).rgb;
    return clamp(c, vec3(0.0), vec3(65000.0));
}

vec3 karis(vec3 a, vec3 b, vec3 c, vec3 d) {
    vec3 avg = 0.25 * (a + b + c + d);
    return avg / (1.0 + ae_luminance(avg));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.dst_size))) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.dst_size);
    vec3 a = tap(uv, vec2(-2.0, 2.0)), b = tap(uv, vec2(0.0, 2.0)), c = tap(uv, vec2(2.0, 2.0));
    vec3 d = tap(uv, vec2(-2.0, 0.0)), e = tap(uv, vec2(0.0, 0.0)), f = tap(uv, vec2(2.0, 0.0));
    vec3 g = tap(uv, vec2(-2.0, -2.0)), h = tap(uv, vec2(0.0, -2.0)), i = tap(uv, vec2(2.0, -2.0));
    vec3 j = tap(uv, vec2(-1.0, 1.0)), k = tap(uv, vec2(1.0, 1.0));
    vec3 l = tap(uv, vec2(-1.0, -1.0)), m = tap(uv, vec2(1.0, -1.0));

    vec3 result;
    if ((pc.flags & 1u) != 0u) {
        result = karis(j, k, l, m) * 0.5 + karis(a, b, d, e) * 0.125 + karis(b, c, e, f) * 0.125 +
                 karis(d, e, g, h) * 0.125 + karis(e, f, h, i) * 0.125;
        result /= max(1.0 - ae_luminance(result), 1e-3); // undo the tonemapped weighting
    } else {
        result = e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
    }
    imageStore(ae_img2d_rgba16f[pc.dst_img], p, vec4(max(result, vec3(0.0)), 1.0));
}
