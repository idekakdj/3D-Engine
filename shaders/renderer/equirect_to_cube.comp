// shaders/renderer/equirect_to_cube.comp — resamples the (mipmapped) equirectangular HDR
// into one mip of the environment cube; dispatched once per mip, z = face.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "ibl_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.dst_size || id.y >= pc.dst_size || id.z >= 6u) {
        return;
    }
    vec3 dir = ibl_cube_dir(id.z, (vec2(id.xy) + 0.5) / float(pc.dst_size));
    vec2 uv = vec2(atan(dir.z, dir.x) / (2.0 * AE_IBL_PI) + 0.5, acos(clamp(dir.y, -1.0, 1.0)) / AE_IBL_PI);
    vec3 c = textureLod(AE_TEX2D(pc.src_tex), uv, pc.src_lod).rgb;
    imageStore(ae_img2darray_rgba16f[pc.dst_img], ivec3(id), vec4(c, 1.0));
}
