// shaders/renderer/taa.comp — temporal anti-aliasing resolve.
// Camera-motion reprojection from the closest depth in a 3x3 neighbourhood, Catmull-Rom
// history sampling, YCoCg variance clipping, luminance-weighted blend (anti-flicker).
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "frame_data.glsl"
#include "color.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant, scalar) uniform TaaPush {
    FrameData frame;
    uint      color_tex;
    uint      depth_tex;
    uint      history_tex;
    uint      out_img;
    uvec2     size;
    float     feedback;
    uint      reset;
} pc;

vec3 load_color(ivec2 q) {
    vec3 c = texelFetch(AE_TEX2D(pc.color_tex), clamp(q, ivec2(0), ivec2(pc.size) - 1), 0).rgb;
    return any(isnan(c)) || any(isinf(c)) ? vec3(0.0) : max(c, vec3(0.0));
}

vec3 sample_history(vec2 uv) {
    return textureLod(AE_TEX2D(pc.history_tex), uv, 0.0).rgb;
}

// 5-tap bicubic Catmull-Rom (Jimenez).
vec3 history_catmull_rom(vec2 uv) {
    vec2 tex_size = vec2(pc.size);
    vec2 sample_pos = uv * tex_size;
    vec2 p1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - p1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 p0 = (p1 - 1.0) / tex_size;
    vec2 p3 = (p1 + 2.0) / tex_size;
    vec2 p12 = (p1 + w2 / w12) / tex_size;
    vec3 r = sample_history(vec2(p12.x, p0.y)) * w12.x * w0.y + sample_history(vec2(p0.x, p12.y)) * w0.x * w12.y +
             sample_history(p12) * w12.x * w12.y + sample_history(vec2(p3.x, p12.y)) * w3.x * w12.y +
             sample_history(vec2(p12.x, p3.y)) * w12.x * w3.y;
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(r / max(wsum, 1e-4), vec3(0.0));
}

vec3 clip_to_aabb(vec3 color, vec3 mn, vec3 mx) {
    vec3 center = 0.5 * (mx + mn);
    vec3 extents = 0.5 * (mx - mn) + 1e-5;
    vec3 v = color - center;
    vec3 a = abs(v / extents);
    float m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? center + v / m : color;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    FrameData frame = pc.frame;
    vec3 current = load_color(p);
    if (pc.reset != 0u) {
        imageStore(ae_img2d_rgba16f[pc.out_img], p, vec4(current, 1.0));
        return;
    }

    // Neighbourhood statistics (YCoCg) + closest depth (reverse-Z: largest value).
    vec3  m1 = vec3(0.0);
    vec3  m2 = vec3(0.0);
    float closest = 0.0;
    ivec2 closest_px = p;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = p + ivec2(x, y);
            vec3  c = ae_rgb_to_ycocg(load_color(q));
            m1 += c;
            m2 += c * c;
            float d = texelFetch(AE_TEX2D(pc.depth_tex), clamp(q, ivec2(0), ivec2(pc.size) - 1), 0).r;
            if (d > closest) {
                closest = d;
                closest_px = q;
            }
        }
    }

    // Camera reprojection of the closest surface.
    vec2 inv_size = 1.0 / vec2(pc.size);
    vec2 uv = (vec2(p) + 0.5) * inv_size;
    vec2 cuv = (vec2(closest_px) + 0.5) * inv_size;
    vec4 world = frame.inv_view_proj * vec4(cuv * 2.0 - 1.0, closest, 1.0);
    world /= world.w;
    vec4 prev = frame.prev_view_proj * world;
    vec2 prev_uv = prev.xy / prev.w * 0.5 + 0.5;
    vec2 history_uv = uv - (cuv - prev_uv);
    if (prev.w <= 0.0 || any(lessThan(history_uv, vec2(0.0))) || any(greaterThan(history_uv, vec2(1.0)))) {
        imageStore(ae_img2d_rgba16f[pc.out_img], p, vec4(current, 1.0));
        return;
    }

    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(abs(m2 / 9.0 - mean * mean));
    const float gamma = 1.25;
    vec3 history = ae_rgb_to_ycocg(history_catmull_rom(history_uv));
    history = ae_ycocg_to_rgb(clip_to_aabb(history, mean - gamma * sigma, mean + gamma * sigma));
    history = max(history, vec3(0.0));

    // Luminance-weighted blend suppresses flicker from bright sub-pixel features.
    float w_cur = (1.0 - pc.feedback) / (1.0 + ae_luminance(current));
    float w_hist = pc.feedback / (1.0 + ae_luminance(history));
    vec3  result = (current * w_cur + history * w_hist) / max(w_cur + w_hist, 1e-6);
    imageStore(ae_img2d_rgba16f[pc.out_img], p, vec4(result, 1.0));
}
