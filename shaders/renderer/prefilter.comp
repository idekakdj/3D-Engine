// shaders/renderer/prefilter.comp — GGX-prefiltered specular cube mip (split sum, N=V=R),
// roughness = mip / (mips - 1). Mip 0 (roughness 0) is a straight resample.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "ibl_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.dst_size || id.y >= pc.dst_size || id.z >= 6u) {
        return;
    }
    vec3 n = ibl_cube_dir(id.z, (vec2(id.xy) + 0.5) / float(pc.dst_size));
    vec3 result;
    if (pc.roughness <= 0.0 || pc.sample_count <= 1u) {
        float lod = max(0.0, log2(float(pc.src_size) / float(pc.dst_size)));
        result = textureLod(AE_TEXCUBE(pc.src_tex), n, lod).rgb;
    } else {
        float alpha = pc.roughness * pc.roughness;
        vec3  sum = vec3(0.0);
        float wsum = 0.0;
        for (uint i = 0u; i < pc.sample_count; ++i) {
            vec3  h = ibl_importance_sample_ggx(ibl_hammersley(i, pc.sample_count), alpha, n);
            float NoH = clamp(dot(n, h), 0.0, 1.0);
            vec3  l = normalize(2.0 * dot(n, h) * h - n);
            float NoL = dot(n, l);
            if (NoL > 0.0) {
                float pdf = ibl_d_ggx(NoH, alpha) * 0.25; // D * NoH / (4 VoH), V = N
                sum += textureLod(AE_TEXCUBE(pc.src_tex), l, ibl_source_lod(pdf, pc.sample_count)).rgb * NoL;
                wsum += NoL;
            }
        }
        result = sum / max(wsum, 1e-4);
    }
    imageStore(ae_img2darray_rgba16f[pc.dst_img], ivec3(id), vec4(result, 1.0));
}
