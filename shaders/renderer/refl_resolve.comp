// shaders/renderer/refl_resolve.comp — builds mip 0 of a reflection probe's environment cube from its
// six captured faces (ADR-0017). Each cube texel's direction (Vulkan cube orientation) is projected
// into the capture view of its major axis, so the capture's own orientation never matters. Texels
// that saw nothing take the sky; back faces of single-sided geometry are black.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/bindless.glsl"
#include "frame_data.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant, scalar) uniform ReflResolvePush {
    FrameData frame;
    uint      capture_tex;
    uint      dst_img;
    uint      size;
    uint      view_base;
    uint      pad0, pad1;
    vec3      position;
    float     pad2;
} pc;

vec3 cube_dir(uint face, vec2 uv) { // == ibl_common.glsl ibl_cube_dir
    vec2 st = uv * 2.0 - 1.0;
    vec3 d;
    switch (face) {
    case 0u: d = vec3(1.0, -st.y, -st.x); break;
    case 1u: d = vec3(-1.0, -st.y, st.x); break;
    case 2u: d = vec3(st.x, 1.0, st.y); break;
    case 3u: d = vec3(st.x, -1.0, -st.y); break;
    case 4u: d = vec3(st.x, -st.y, 1.0); break;
    default: d = vec3(-st.x, -st.y, -1.0); break;
    }
    return normalize(d);
}

uint major_face(vec3 d) { // +X, -X, +Y, -Y, +Z, -Z (render_math.cpp point_shadow_face_for)
    vec3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) {
        return d.x >= 0.0 ? 0u : 1u;
    }
    if (a.y >= a.z) {
        return d.y >= 0.0 ? 2u : 3u;
    }
    return d.z >= 0.0 ? 4u : 5u;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size || id.z >= 6u) {
        return;
    }
    FrameData frame = pc.frame;
    vec3 dir = cube_dir(id.z, (vec2(id.xy) + 0.5) / float(pc.size));
    uint f = major_face(dir);
    vec4 clip = frame.spot_shadows.items[pc.view_base + f].view_proj * vec4(pc.position + dir, 1.0);
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    ivec2 texel = clamp(ivec2(uv * float(pc.size)), ivec2(0), ivec2(int(pc.size) - 1));
    vec4 c = texelFetch(AE_TEX2DARRAY(pc.capture_tex), ivec3(texel, int(f)), 0);
    vec3 radiance;
    if (c.a < -0.5) {
        radiance = vec3(0.0);
    } else if (c.a > 0.5) {
        radiance = c.rgb;
    } else if (frame.skybox_map != AE_INVALID_INDEX) {
        radiance = textureLod(AE_TEXCUBE(frame.skybox_map), dir, 0.0).rgb * frame.ibl_intensity;
    } else {
        radiance = frame.ambient;
    }
    imageStore(ae_img2darray_rgba16f[pc.dst_img], ivec3(id), vec4(radiance, 1.0));
}
