#version 460
// Animated plasma written into a bindless storage image (binding 1, rgba8 alias).
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 p  = ivec2(gl_GlobalInvocationID.xy);
    vec2  uv = vec2(p) / 256.0;
    vec3  c  = 0.5 + 0.5 * cos(pc.time * 1.5 + uv.xyx * 6.2831 + vec3(0.0, 2.0, 4.0));
    imageStore(ae_img2d_rgba8[nonuniformEXT(pc.pattern_img)], p, vec4(c, 1.0));
}
